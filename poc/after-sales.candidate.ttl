@prefix udom: <https://ontodomain.dev/udom#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix as: <https://ontodomain.dev/example/after-sales#> .
@prefix dcterms: <http://purl.org/dc/terms/> .


<https://ontodomain.dev/example/after-sales> a owl:Ontology ; owl:imports <https://ontodomain.dev/udom> ;
    rdfs:label "智家售后域候选模型（实例）"@zh ; owl:versionInfo "udom=0.1.1" .

as:ev-01 a udom:Evidence ;
    rdfs:label "白皮书-愿景使命"@zh ;
    udom:kb "kb-aftersales" ;
    udom:docTitle "智家商城售后服务业务白皮书" ;
    udom:docType udom:enum_docType_business ;
    udom:location "§1" ;
    udom:fragment "我们的愿景是成为家电零售行业的售后服务标杆。售后团队的使命是：让每一次售后都简单、透明、可预期。" .

as:ev-02 a udom:Evidence ;
    rdfs:label "白皮书-指标表"@zh ;
    udom:kb "kb-aftersales" ;
    udom:docTitle "智家商城售后服务业务白皮书" ;
    udom:docType udom:enum_docType_business ;
    udom:location "§2" ;
    udom:fragment "售后满意度 4.5→≥4.8（2026-Q3）；平均售后处理时长 52h→≤24h（2026-Q2）；一次解决率 71%→≥85%（2026-Q3）" .

as:ev-03 a udom:Evidence ;
    rdfs:label "白皮书-策略举措"@zh ;
    udom:kb "kb-aftersales" ;
    udom:docTitle "智家商城售后服务业务白皮书" ;
    udom:docType udom:enum_docType_business ;
    udom:location "§3" ;
    udom:fragment "策略S1：售后全流程数字化与智能分流。举措：引入智能客服完成初判与分流；退款执行自动化；与物流商系统直连。" .

as:ev-04 a udom:Evidence ;
    rdfs:label "白皮书-政策规则"@zh ;
    udom:kb "kb-aftersales" ;
    udom:docTitle "智家商城售后服务业务白皮书" ;
    udom:docType udom:enum_docType_business ;
    udom:location "§4" ;
    udom:fragment "政策P1：涉及资金退款的售后处置，必须保留人工复核通道。R1：七天无理由退货须未拆封且配件齐全；R2：单笔退款超2000元须售后主管审批。" .

as:ev-05 a udom:Evidence ;
    rdfs:label "白皮书-判定矩阵"@zh ;
    udom:kb "kb-aftersales" ;
    udom:docTitle "智家商城售后服务业务白皮书" ;
    udom:docType udom:enum_docType_business ;
    udom:location "§4-R4" ;
    udom:fragment "R3：大家电安装完成后不支持七天无理由退货；R4：退换货判定按商品类型×使用情形矩阵执行。" .

as:ev-06 a udom:Evidence ;
    rdfs:label "白皮书-术语"@zh ;
    udom:kb "kb-aftersales" ;
    udom:docTitle "智家商城售后服务业务白皮书" ;
    udom:docType udom:enum_docType_business ;
    udom:location "§5" ;
    udom:fragment "售后单：客户就一笔订单提出的退货、换货、维修诉求所形成的业务单据，是售后业务的核心载体。" .

as:ev-07 a udom:Evidence ;
    rdfs:label "白皮书-流程"@zh ;
    udom:kb "kb-aftersales" ;
    udom:docTitle "智家商城售后服务业务白皮书" ;
    udom:docType udom:enum_docType_business ;
    udom:location "§6" ;
    udom:fragment "流程：客户提交申请→初审（现人工）→主管审核→取件或寄修→验收→退款或换货→关单回访。" .

as:ev-08 a udom:Evidence ;
    rdfs:label "白皮书-组织"@zh ;
    udom:kb "kb-aftersales" ;
    udom:docTitle "智家商城售后服务业务白皮书" ;
    udom:docType udom:enum_docType_business ;
    udom:location "§7" ;
    udom:fragment "售后服务部：售后业务归口部门，下辖审核组与物流协同组。" .

as:ev-09 a udom:Evidence ;
    rdfs:label "白皮书-风险"@zh ;
    udom:kb "kb-aftersales" ;
    udom:docTitle "智家商城售后服务业务白皮书" ;
    udom:docType udom:enum_docType_business ;
    udom:location "§8" ;
    udom:fragment "大促期间售后单量可达日常3-5倍，初审环节易积压，可能导致处理时长指标恶化。" .

as:ev-10 a udom:Evidence ;
    rdfs:label "接口说明-系统清单"@zh ;
    udom:kb "kb-aftersales-sys" ;
    udom:docTitle "售后中台系统现状与接口说明" ;
    udom:docType udom:enum_docType_technical ;
    udom:location "§1" ;
    udom:fragment "ASS售后系统（自研遗留2015年Java单体）；OMS订单系统；WMS仓储系统；支付网关（外采SaaS）。" .

as:ev-11 a udom:Evidence ;
    rdfs:label "接口说明-接口表"@zh ;
    udom:kb "kb-aftersales-sys" ;
    udom:docTitle "售后中台系统现状与接口说明" ;
    udom:docType udom:enum_docType_technical ;
    udom:location "§2" ;
    udom:fragment "createAfterSaleOrder(POST,非幂等)；queryAfterSaleStatus(GET,幂等)；approveRefund(POST,幂等)；executeRefund(POST,需幂等键)；arrangePickup(POST,非幂等)。" .

as:ev-12 a udom:Evidence ;
    rdfs:label "接口说明-数据表"@zh ;
    udom:kb "kb-aftersales-sys" ;
    udom:docTitle "售后中台系统现状与接口说明" ;
    udom:docType udom:enum_docType_technical ;
    udom:location "§3" ;
    udom:fragment "as_order（售后单主表）：单号、订单号、类型（退/换/修）、状态、金额；refund_record（退款记录）：金额、审批人、幂等键。" .

as:ev-13 a udom:Evidence ;
    rdfs:label "接口说明-痛点"@zh ;
    udom:kb "kb-aftersales-sys" ;
    udom:docTitle "售后中台系统现状与接口说明" ;
    udom:docType udom:enum_docType_technical ;
    udom:location "§4" ;
    udom:fragment "初审全靠人工平均每单4小时；createAfterSaleOrder不幂等，重复点击产生重复售后单需人工合并；审批通过后人工再操作退款平均延迟6小时。" .

as:ev-14 a udom:Evidence ;
    rdfs:label "接口说明-运行数据"@zh ;
    udom:kb "kb-aftersales-sys" ;
    udom:docTitle "售后中台系统现状与接口说明" ;
    udom:docType udom:enum_docType_technical ;
    udom:location "§5" ;
    udom:fragment "日常售后单量约1200单/天；大促峰值5000+单/天。" .

