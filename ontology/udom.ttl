# ===== 约束规则注解（SHACL 形状属 v0.2，此处文档化） =====

udom:ConstraintRule a owl:Class ; rdfs:label "约束规则"@zh .

udom:severity a owl:DatatypeProperty ; rdfs:label "严重级别"@zh .

udom:R1 a udom:ConstraintRule ; rdfs:label "R1"@en ;
    udom:severity "error" ; rdfs:comment "Objective 必须 measures ≥1 个 Goal（measures.card=1..*）"@zh .

udom:R2 a udom:ConstraintRule ; rdfs:label "R2"@en ;
    udom:severity "error" ; rdfs:comment "Agent 恰有 1 个 hasMission 与 1 个 belongsTo（card=1）"@zh .

udom:R3 a udom:ConstraintRule ; rdfs:label "R3"@en ;
    udom:severity "error" ; rdfs:comment "Tool 必填 side_effects 与 idempotent（attrs.req）"@zh .

udom:R4 a udom:ConstraintRule ; rdfs:label "R4"@en ;
    udom:severity "warn" ; rdfs:comment "未废弃 BusinessRule 应有 ≥1 执行点（enforcedBy）"@zh .

udom:R5 a udom:ConstraintRule ; rdfs:label "R5"@en ;
    udom:severity "error" ; rdfs:comment "Agent.autonomy≥L2 ⇒ ≥1 个 kind=hitl 的 Guardrail protects 它，且 ≥1 个 Eval validates 它"@zh .

udom:R6 a udom:ConstraintRule ; rdfs:label "R6"@en ;
    udom:severity "warn" ; rdfs:comment "每个元素（除 Evidence）应有 ≥1 条证据链接"@zh .

udom:R7 a udom:ConstraintRule ; rdfs:label "R7"@en ;
    udom:severity "error" ; rdfs:comment "Skill 必须 realizes ≥1 个 BusinessCapability"@zh .

udom:R8 a udom:ConstraintRule ; rdfs:label "R8"@en ;
    udom:severity "warn" ; rdfs:comment "同一 BoundedContext 内 GlossaryTerm.term 应唯一"@zh .

udom:R9 a udom:ConstraintRule ; rdfs:label "R9"@en ;
    udom:severity "error" ; rdfs:comment "contextRelationship.pattern 必填且为合法枚举（结构校验执行）"@zh .

udom:R10 a udom:ConstraintRule ; rdfs:label "R10"@en ;
    udom:severity "warn" ; rdfs:comment "Mission 应 makesOperative ≥1 个 Vision"@zh .
